{
    "name": "AI Orchestrator",
    "version": "0.10.1",
    "slug": "ai-orchestrator",
    "description": "Phase 8: Self-contained reasoning + memory + plan-approve-execute + triggers + streaming + native prompt library (no external MCP prerequisite)",
    "url": "https://github.com/constructorfleet/HASS-AI-Orchestrator",
    "arch": [
        "amd64",
        "armv7",
        "aarch64"
    ],
    "startup": "application",
    "boot": "auto",
    "host_network": true,
    "init": false,
    "ingress": true,
    "ingress_port": 8999,
    "ingress_entry": "/",
    "panel_icon": "mdi:robot",
    "map": [
        "addon_config:rw"
    ],
    "hassio_api": true,
    "hassio_role": "default",
    "homeassistant_api": true,
    "options": {
        "ollama_host": "http://localhost:11434",
        "architect": {
            "provider": "ollama",
            "orchestrator_model": "deepseek-r1:8b",
            "smart_model": "deepseek-r1:8b",
            "fast_model": "mistral:7b-instruct"
        },
        "deep_reasoning": {
            "provider": "ollama",
            "model": "qwen2.5:14b-instruct",
            "max_iterations": 12
        },
        "openai": {
            "api_key": "",
            "base_url": "",
            "model": "gpt-4o-mini"
        },
        "anthropic": {
            "api_key": "",
            "model": "claude-opus-4-7"
        },
        "gemini": {
            "api_key": "",
            "model": "gemini-robotics-er-1.5-preview",
            "use_for_dashboard": false
        },
        "github": {
            "token": "",
            "model": "gpt-4o-mini"
        },
        "foundry": {
            "endpoint": "",
            "api_key": "",
            "bearer_token": "",
            "model": "",
            "agent_id": ""
        },
        "mcp": {
            "server_url": "",
            "server_token": ""
        },
        "home_assistant": {
            "access_token": ""
        },
        "security": {
            "api_token": ""
        },
        "dry_run_mode": true,
        "disable_telemetry": true,
        "log_level": "info",
        "decision_interval": 120,
        "enable_gpu": false,
        "allowed_domains": "light,switch,fan,climate,media_player,cover,input_boolean,input_select,input_number,scene,button,vacuum,water_heater,lock,alarm_control_panel,camera",
        "blocked_domains": "shell_command,hassio,script,automation,rest_command",
        "high_impact_services": "lock.unlock,lock.lock,alarm_control_panel.alarm_disarm,alarm_control_panel.alarm_arm_home,alarm_control_panel.alarm_arm_away,camera.disable_motion_detection,camera.turn_off",
        "min_temp": 10.0,
        "max_temp": 30.0,
        "max_temp_change": 3.0
    },
    "schema": {
        "ollama_host": "str",
        "architect": {
            "provider": "list(ollama|openai|github|foundry)?",
            "orchestrator_model": "str",
            "smart_model": "str",
            "fast_model": "str"
        },
        "deep_reasoning": {
            "provider": "list(ollama|anthropic)?",
            "model": "str",
            "max_iterations": "int(1,40)"
        },
        "openai": {
            "api_key": "password?",
            "base_url": "url?",
            "model": "str?"
        },
        "anthropic": {
            "api_key": "password?",
            "model": "str?"
        },
        "gemini": {
            "api_key": "password?",
            "model": "str?",
            "use_for_dashboard": "bool"
        },
        "github": {
            "token": "password?",
            "model": "str?"
        },
        "foundry": {
            "endpoint": "url?",
            "api_key": "password?",
            "bearer_token": "password?",
            "model": "str?",
            "agent_id": "str?"
        },
        "mcp": {
            "server_url": "url?",
            "server_token": "password?"
        },
        "home_assistant": {
            "access_token": "password?"
        },
        "security": {
            "api_token": "password?"
        },
        "dry_run_mode": "bool",
        "disable_telemetry": "bool",
        "log_level": "list(debug|info|warning|error)",
        "decision_interval": "int(30,600)",
        "enable_gpu": "bool",
        "allowed_domains": "str",
        "blocked_domains": "str",
        "high_impact_services": "str",
        "min_temp": "float",
        "max_temp": "float",
        "max_temp_change": "float"
    }
}
